{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus datasource backing prometheus.constantlee.us",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.1.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "row", "name": "Row", "version": "" }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "llama.cpp server metrics (llamacpp:*) for the ryzen deployment, plus the companion RTX 3070 GPU row. Throughput panels show both the last-request gauge and the rate-derived average over the dashboard's rate interval.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "refresh": "30s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["llama.cpp", "llm", "ai"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Datasource",
        "multi": false,
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "queryValue": "",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "allValue": ".*",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(llamacpp:tokens_predicted_total{name=\"llama-cpp-ryzen\"}, kubernetes_pod_name)",
        "hide": 0,
        "includeAll": true,
        "label": "Pod",
        "multi": true,
        "name": "pod",
        "options": [],
        "query": {
          "qryType": 1,
          "query": "label_values(llamacpp:tokens_predicted_total{name=\"llama-cpp-ryzen\"}, kubernetes_pod_name)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-3h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "llama.cpp — ryzen",
  "uid": "llamacpp-ryzen",
  "weekStart": "",
  "panels": [
    { "type": "row", "id": 1, "title": "Overview", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "panels": [] },

    {
      "type": "stat",
      "id": 2,
      "title": "Server",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "1": { "text": "UP", "color": "green", "index": 0 } } },
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red", "index": 1 } } }
          ],
          "noValue": "OFFLINE",
          "color": { "mode": "fixed", "fixedColor": "red" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "max(up{name=\"llama-cpp-ryzen\", kubernetes_pod_name=~\"$pod\"})", "instant": true }
      ]
    },
    {
      "type": "stat",
      "id": 3,
      "title": "Generation (last request)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "options": {
        "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none", "decimals": 1,
          "color": { "mode": "fixed", "fixedColor": "green" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] },
          "custom": {}
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "avg(llamacpp:predicted_tokens_seconds{name=\"llama-cpp-ryzen\", kubernetes_pod_name=~\"$pod\"})", "legendFormat": "tok/s" }
      ]
    },
    {
      "type": "stat",
      "id": 4,
      "title": "Prompt / prefill (last request)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "options": {
        "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none", "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "blue", "value": null } ] }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "avg(llamacpp:prompt_tokens_seconds{name=\"llama-cpp-ryzen\", kubernetes_pod_name=~\"$pod\"})", "legendFormat": "tok/s" }
      ]
    },
    {
      "type": "stat",
      "id": 5,
      "title": "Requests processing",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "options": {
        "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none", "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "text", "value": null }, { "color": "green", "value": 1 } ] }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(llamacpp:requests_processing{name=\"llama-cpp-ryzen\", kubernetes_pod_name=~\"$pod\"})", "legendFormat": "processing" }
      ]
    },
    {
      "type": "stat",
      "id": 6,
      "title": "Requests deferred (queued)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "options": {
        "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none", "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 } ] }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(llamacpp:requests_deferred{name=\"llama-cpp-ryzen\", kubernetes_pod_name=~\"$pod\"})", "legendFormat": "deferred" }
      ]
    },
    {
      "type": "stat",
      "id": 7,
      "title": "Tokens generated (24h)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "options": {
        "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short", "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "purple" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "purple", "value": null } ] }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(increase(llamacpp:tokens_predicted_total{name=\"llama-cpp-ryzen\", kubernetes_pod_name=~\"$pod\"}[24h]))", "legendFormat": "tokens" }
      ]
    },

    { "type": "row", "id": 8, "title": "Throughput", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }, "panels": [] },

    {
      "type": "timeseries",
      "id": 10,
      "title": "Generation throughput (tok/s)",
      "description": "Blue = rate-derived average over the rate interval (tokens_predicted_total / tokens_predicted_seconds_total). Yellow = the server's last-request gauge.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "none", "decimals": 1, "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "tok/s", "axisPlacement": "auto",
            "barAlignment": 0, "drawStyle": "line", "fillOpacity": 10, "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false }, "lineInterpolation": "linear",
            "lineWidth": 2, "pointSize": 5, "scaleDistribution": { "type": "linear" }, "showPoints": "never",
            "spanNulls": false, "stacking": { "group": "A", "mode": "none" }, "thresholdsStyle": { "mode": "off" }
          },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "avg while generating" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } } ] },
          { "matcher": { "id": "byName", "options": "last-request gauge" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }, { "id": "custom.fillOpacity", "value": 0 }, { "id": "custom.lineStyle", "value": { "dash": [6, 6], "fill": "dash" } } ] }
        ]
      },
      "options": {
        "legend": { "calcs": ["mean", "max", "lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(rate(llamacpp:tokens_predicted_total{name=\"llama-cpp-ryzen\", kubernetes_pod_name=~\"$pod\"}[$__rate_interval])) / sum(rate(llamacpp:tokens_predicted_seconds_total{name=\"llama-cpp-ryzen\", kubernetes_pod_name=~\"$pod\"}[$__rate_interval]))", "legendFormat": "avg while generating" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "avg(llamacpp:predicted_tokens_seconds{name=\"llama-cpp-ryzen\", kubernetes_pod_name=~\"$pod\"})", "legendFormat": "last-request gauge" }
      ]
    },
    {
      "type": "timeseries",
      "id": 11,
      "title": "Prompt / prefill throughput (tok/s)",
      "description": "Blue = rate-derived average over the rate interval (prompt_tokens_total / prompt_seconds_total). Yellow = the server's last-request gauge.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "none", "decimals": 0, "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "tok/s", "axisPlacement": "auto",
            "barAlignment": 0, "drawStyle": "line", "fillOpacity": 10, "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false }, "lineInterpolation": "linear",
            "lineWidth": 2, "pointSize": 5, "scaleDistribution": { "type": "linear" }, "showPoints": "never",
            "spanNulls": false, "stacking": { "group": "A", "mode": "none" }, "thresholdsStyle": { "mode": "off" }
          },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "avg while prefilling" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } } ] },
          { "matcher": { "id": "byName", "options": "last-request gauge" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }, { "id": "custom.fillOpacity", "value": 0 }, { "id": "custom.lineStyle", "value": { "dash": [6, 6], "fill": "dash" } } ] }
        ]
      },
      "options": {
        "legend": { "calcs": ["mean", "max", "lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(rate(llamacpp:prompt_tokens_total{name=\"llama-cpp-ryzen\", kubernetes_pod_name=~\"$pod\"}[$__rate_interval])) / sum(rate(llamacpp:prompt_seconds_total{name=\"llama-cpp-ryzen\", kubernetes_pod_name=~\"$pod\"}[$__rate_interval]))", "legendFormat": "avg while prefilling" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "avg(llamacpp:prompt_tokens_seconds{name=\"llama-cpp-ryzen\", kubernetes_pod_name=~\"$pod\"})", "legendFormat": "last-request gauge" }
      ]
    },

    { "type": "row", "id": 12, "title": "Token Volume & Prompt Cache", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 }, "panels": [] },

    {
      "type": "timeseries",
      "id": 14,
      "title": "Token rate (tok/s, server-wide)",
      "description": "Per-second token counts including idle gaps, so lower than the 'throughput while active' panels.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "fieldConfig": {
        "defaults": {
          "unit": "none", "decimals": 1, "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "tok/s", "axisPlacement": "auto",
            "barAlignment": 0, "drawStyle": "line", "fillOpacity": 15, "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false }, "lineInterpolation": "linear",
            "lineWidth": 2, "pointSize": 5, "scaleDistribution": { "type": "linear" }, "showPoints": "never",
            "spanNulls": false, "stacking": { "group": "A", "mode": "none" }, "thresholdsStyle": { "mode": "off" }
          },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(rate(llamacpp:tokens_predicted_total{name=\"llama-cpp-ryzen\", kubernetes_pod_name=~\"$pod\"}[$__rate_interval]))", "legendFormat": "generated" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(rate(llamacpp:prompt_tokens_total{name=\"llama-cpp-ryzen\", kubernetes_pod_name=~\"$pod\"}[$__rate_interval]))", "legendFormat": "prompt (processed)" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(rate(llamacpp:prompt_tokens_cached_total{name=\"llama-cpp-ryzen\", kubernetes_pod_name=~\"$pod\"}[$__rate_interval]))", "legendFormat": "prompt (from cache)" }
      ]
    },
    {
      "type": "timeseries",
      "id": 15,
      "title": "Prompt cache hit ratio",
      "description": "cached / (cached + processed) prompt tokens over the rate interval.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "decimals": 0, "min": 0, "max": 1,
          "color": { "mode": "fixed", "fixedColor": "green" },
          "custom": {
            "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "", "axisPlacement": "auto",
            "barAlignment": 0, "drawStyle": "line", "fillOpacity": 20, "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false }, "lineInterpolation": "linear",
            "lineWidth": 2, "pointSize": 5, "scaleDistribution": { "type": "linear" }, "showPoints": "never",
            "spanNulls": true, "stacking": { "group": "A", "mode": "none" }, "thresholdsStyle": { "mode": "off" }
          },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": ["mean", "min", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(rate(llamacpp:prompt_tokens_cached_total{name=\"llama-cpp-ryzen\", kubernetes_pod_name=~\"$pod\"}[$__rate_interval])) / clamp_min(sum(rate(llamacpp:prompt_tokens_cached_total{name=\"llama-cpp-ryzen\", kubernetes_pod_name=~\"$pod\"}[$__rate_interval])) + sum(rate(llamacpp:prompt_tokens_total{name=\"llama-cpp-ryzen\", kubernetes_pod_name=~\"$pod\"}[$__rate_interval])), 1)", "legendFormat": "cache hit ratio" }
      ]
    },

    { "type": "row", "id": 16, "title": "Latency (time per token)", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 }, "panels": [] },

    {
      "type": "timeseries",
      "id": 18,
      "title": "Time per generated token (ms)",
      "description": "1000 * tokens_predicted_seconds_total / tokens_predicted_total over the rate interval. Inverse of decode throughput.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms", "decimals": 1, "min": 0,
          "color": { "mode": "fixed", "fixedColor": "orange" },
          "custom": {
            "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "ms/token", "axisPlacement": "auto",
            "barAlignment": 0, "drawStyle": "line", "fillOpacity": 10, "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false }, "lineInterpolation": "linear",
            "lineWidth": 2, "pointSize": 5, "scaleDistribution": { "type": "linear" }, "showPoints": "never",
            "spanNulls": false, "stacking": { "group": "A", "mode": "none" }, "thresholdsStyle": { "mode": "off" }
          },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": ["mean", "min", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "1000 * sum(rate(llamacpp:tokens_predicted_seconds_total{name=\"llama-cpp-ryzen\", kubernetes_pod_name=~\"$pod\"}[$__rate_interval])) / sum(rate(llamacpp:tokens_predicted_total{name=\"llama-cpp-ryzen\", kubernetes_pod_name=~\"$pod\"}[$__rate_interval]))", "legendFormat": "ms / generated token" }
      ]
    },
    {
      "type": "timeseries",
      "id": 19,
      "title": "Time per prompt token (ms)",
      "description": "1000 * prompt_seconds_total / prompt_tokens_total over the rate interval. Inverse of prefill throughput.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms", "decimals": 2, "min": 0,
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "custom": {
            "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "ms/token", "axisPlacement": "auto",
            "barAlignment": 0, "drawStyle": "line", "fillOpacity": 10, "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false }, "lineInterpolation": "linear",
            "lineWidth": 2, "pointSize": 5, "scaleDistribution": { "type": "linear" }, "showPoints": "never",
            "spanNulls": false, "stacking": { "group": "A", "mode": "none" }, "thresholdsStyle": { "mode": "off" }
          },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": ["mean", "min", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "1000 * sum(rate(llamacpp:prompt_seconds_total{name=\"llama-cpp-ryzen\", kubernetes_pod_name=~\"$pod\"}[$__rate_interval])) / sum(rate(llamacpp:prompt_tokens_total{name=\"llama-cpp-ryzen\", kubernetes_pod_name=~\"$pod\"}[$__rate_interval]))", "legendFormat": "ms / prompt token" }
      ]
    },

